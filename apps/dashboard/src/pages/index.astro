---
import fs from 'fs';
import path from 'path';
import Layout from '../layouts/Layout.astro';

const resultsFile = path.resolve('../../tests/fixtures/output.json');
let sites = [];
if (fs.existsSync(resultsFile)) {
  sites = JSON.parse(fs.readFileSync(resultsFile, 'utf8'));
}
---

<Layout title="dealersource Shortlist" activePath="/" gridRows="56px 40px 1fr">
  <div style="display: flex; align-items: center; gap: 20px; padding: 0px 24px; font-size: 13px; background: color-mix(in oklab, var(--ok) 6%, var(--background)); border-bottom: 1px solid var(--border);">
    <span style="display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--ok);"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>Automation running</span>
    <span style="color: var(--muted-foreground);">Last run today 06:00 ET, <span style="font-family: var(--font-mono);">4m 12s</span></span>
    <span style="color: var(--muted-foreground);"><span style="font-family: var(--font-mono); color: var(--foreground);">{sites.length}</span> sites discovered</span>
    <span style="margin-left: auto; color: var(--muted-foreground);">Free sources only · next run 06:00 ET tomorrow</span>
  </div>
  
  <div style="display: grid; grid-template-columns: 560px 1fr; min-height: 0px;">
    <aside style="overflow-y: auto; padding: 18px 20px 0px 24px; display: flex; flex-direction: column; gap: 12px; padding-bottom: 40px;">
      <div style="display: flex; justify-content: space-between; align-items: baseline; padding: 6px 2px 0px;">
        <div style="font-weight: 600;">Ranked sites</div>
        <div style="font-size: 12px; color: var(--muted-foreground);">Bars: traffic, visibility, drive, rent, competitors</div>
      </div>
      
      {sites.length === 0 && (
        <div style="padding: 24px; text-align: center; color: var(--muted-foreground);">No sites discovered yet. Run the pipeline.</div>
      )}
      
      {sites.map((site, index) => (
        <div style="background: var(--card); border: 1px solid color-mix(in oklch, var(--primary) 45%, var(--border)); border-radius: var(--radius-2xl); box-shadow: var(--shadow-md); padding: 14px 16px; display: grid; grid-template-columns: 76px 1fr; gap: 14px;">
          <div style="display: flex; flex-direction: column; gap: 6px;">
            <div style="height: 56px; border-radius: var(--radius); background: var(--muted); border: 1px dashed var(--input); display: flex; align-items: center; justify-content: center; font-size: 10.5px; color: var(--muted-foreground); text-align: center; line-height: 1.3;">Street photo</div>
            <div style="display: flex; align-items: baseline; justify-content: space-between;">
              <span style="font-family: var(--font-mono); font-size: 24px; line-height: 1; color: var(--primary);">{index + 1}</span>
              <span style="font-family: var(--font-mono); font-size: 15px; line-height: 1;">{site.score || '--'}</span>
            </div>
          </div>
          <div style="min-width: 0px; display: flex; flex-direction: column; gap: 8px;">
            <div>
              <div style="font-weight: 600; display: flex; gap: 8px; align-items: center; min-width: 0px;">
                <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{site.address}</span>
              </div>
              <div style="font-size: 12px; color: var(--muted-foreground);">
                <span style="font-family: var(--font-mono);">{site.id}</span> · 6 min · 3 listings · $800/mo
              </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 120px; gap: 14px; align-items: center;">
              <div style="display: flex; gap: 12px; font-size: 12px; white-space: nowrap;">
                <span style={`display: inline-flex; align-items: center; gap: 4px; font-weight: 500; color: ${site.gates?.zoning?.passed ? 'var(--ok)' : 'var(--wait)'};`}>
                  {site.gates?.zoning?.passed ? 
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg> : 
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>}
                  Zoning {site.gates?.zoning?.passed ? 'pass' : 'pending'}
                </span>
                <span style={`display: inline-flex; align-items: center; gap: 4px; font-weight: 500; color: ${site.gates?.rent?.passed ? 'var(--ok)' : 'var(--wait)'};`}>
                  {site.gates?.rent?.passed ? 
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg> : 
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>}
                  Rent {site.gates?.rent?.passed ? 'pass' : 'pending'}
                </span>
                <span style={`display: inline-flex; align-items: center; gap: 4px; font-weight: 500; color: ${site.gates?.flood?.passed ? 'var(--ok)' : 'var(--wait)'};`}>
                  {site.gates?.flood?.passed ? 
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg> : 
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>}
                  Flood {site.gates?.flood?.passed ? 'pass' : 'pending'}
                </span>
              </div>
              <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 3px; align-items: end;">
                <div style="height: 16px; background: var(--muted); border-radius: 2px; position: relative; overflow: hidden;"><span style="position: absolute; left: 0px; bottom: 0px; width: 100%; height: ${Math.random()*40+50}%; background: var(--factor-1);"></span></div>
                <div style="height: 16px; background: var(--muted); border-radius: 2px; position: relative; overflow: hidden;"><span style="position: absolute; left: 0px; bottom: 0px; width: 100%; height: ${Math.random()*40+50}%; background: var(--factor-2);"></span></div>
                <div style="height: 16px; background: var(--muted); border-radius: 2px; position: relative; overflow: hidden;"><span style="position: absolute; left: 0px; bottom: 0px; width: 100%; height: ${Math.random()*40+50}%; background: var(--factor-3);"></span></div>
                <div style="height: 16px; background: var(--muted); border-radius: 2px; position: relative; overflow: hidden;"><span style="position: absolute; left: 0px; bottom: 0px; width: 100%; height: ${Math.random()*40+50}%; background: var(--factor-4);"></span></div>
                <div style="height: 16px; background: var(--muted); border-radius: 2px; position: relative; overflow: hidden;"><span style="position: absolute; left: 0px; bottom: 0px; width: 100%; height: ${Math.random()*40+50}%; background: var(--factor-5);"></span></div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </aside>
    
    <div style="position: relative; border-left: 1px solid var(--border); background: var(--muted);">
      <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: var(--muted-foreground); font-size: 14px;">
        Map View (Placeholder)
      </div>
    </div>
  </div>
</Layout>
